{
  "name": "@allotr/web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-tokens.ts && vite build",
    "tokens": "node scripts/generate-tokens.ts",
    "tokens:check": "node scripts/generate-tokens.ts --check",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p src/sw",
    "test": "vitest run",
    "e2e": "node scripts/generate-tokens.ts && vite build && playwright test && playwright test -c playwright.components.config.ts",
    "e2e:components": "playwright test -c playwright.components.config.ts"
  },
  "dependencies": {
    "@allotr/shared": "workspace:*",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.39",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fast-check": "catalog:",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "8.3.1",
    "vitest": "catalog:"
  }
}
