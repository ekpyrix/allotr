# Copy to deploy/.env. Never commit it.

# URL people open in the browser (scheme, host and port, no trailing path).
ALLOTR_BASE_URL=http://localhost:8080

# At least 32 characters; the server refuses to start with this placeholder.
# Generate one with: openssl rand -base64 32
ALLOTR_SECRET_KEY=change-me

# Host address and port Docker publishes. Loopback by default.
# ALLOTR_PUBLISH=127.0.0.1:8080

# Reverse proxies whose X-Forwarded-For is trusted, as IPs or CIDR ranges,
# e.g. the Docker network of your proxy.
# ALLOTR_TRUSTED_PROXIES=172.16.0.0/12

# all (default), server or gateway: run one role per container.
# ALLOTR_ROLE=all

# Seconds between checks for bills and IOUs that are due (reminders).
# ALLOTR_REMINDER_INTERVAL_SECONDS=900

# fatal, error, warn, info (default), debug, trace or silent.
# ALLOTR_LOG_LEVEL=info
