# Copy to .env for local development. Never commit .env.
# The container image reads the same variables (deploy/.env.example).

# SQLite database file. Pre-migration backups go to a backups/ folder next to it.
# A relative path is resolved from the server's working directory (apps/server
# under `make dev`).
ALLOTR_DATABASE_PATH=./data/allotr.db

# Public URL users open in the browser, used for links and origin checks.
# Under `make dev` the browser talks to Vite, which forwards /v1 to the API,
# so use the Vite address. A built app served by the server uses the
# server's own address, e.g. http://localhost:8080.
ALLOTR_BASE_URL=http://localhost:5173

# At least 32 characters. Generate one with: openssl rand -base64 32
ALLOTR_SECRET_KEY=replace-with-a-random-value-of-32-or-more-characters

# Listen address and port. Defaults: 127.0.0.1 and 8080.
# ALLOTR_HOST=127.0.0.1
# ALLOTR_PORT=8080

# Reverse proxies whose X-Forwarded-For header is trusted for the client
# address (rate limiting, session records): comma-separated IPs or CIDR ranges.
# Leave empty when clients connect directly.
# ALLOTR_TRUSTED_PROXIES=172.16.0.0/12

# Seconds between checks for bills and IOUs that are due (reminders).
# ALLOTR_REMINDER_INTERVAL_SECONDS=900

# Password and 2FA sign-in requests per client address per minute.
# ALLOTR_SIGN_IN_REQUESTS_PER_MINUTE=10

# fatal, error, warn, info (default), debug, trace or silent.
# ALLOTR_LOG_LEVEL=info
