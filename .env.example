# Copy to .env for local development. Never commit .env.
# The container image reads the same variables (deploy/.env.example).

# SQLite database file. Pre-migration backups go to a backups/ folder next to it.
# A relative path is resolved from the server's working directory (apps/server
# under `make dev`).
ALLOTR_DATABASE_PATH=./data/allotr.db

# Public URL users open in the browser, used for links and origin checks.
ALLOTR_BASE_URL=http://localhost:8080

# At least 32 characters. Generate one with: openssl rand -base64 32
ALLOTR_SECRET_KEY=replace-with-a-random-value-of-32-or-more-characters

# Listen address and port. Defaults: 127.0.0.1 and 8080.
# ALLOTR_HOST=127.0.0.1
# ALLOTR_PORT=8080

# fatal, error, warn, info (default), debug, trace or silent.
# ALLOTR_LOG_LEVEL=info
